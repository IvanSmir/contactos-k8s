pipeline {
    agent any

    environment {
        DOCKERHUB_CREDENTIALS = credentials('dockerhub-credentials')
        FRONTEND_IMAGE        = "${DOCKERHUB_CREDENTIALS_USR}/contactos-frontend"
        IMAGE_TAG             = "${BUILD_NUMBER}"
    }

    parameters {
        booleanParam(name: 'DEPLOY', defaultValue: false, description: 'Desplegar en Kubernetes luego del build?')
    }

    stages {

        stage('Checkout') {
            steps {
                echo 'Obteniendo codigo fuente...'
                checkout scm
            }
        }

        stage('Build') {
            steps {
                echo 'Verificando archivos del frontend...'
                dir('frontend') {
                    sh 'ls -la'
                }
            }
        }

        stage('Docker Build') {
            steps {
                echo 'Construyendo imagen Docker del frontend...'
                sh 'docker build -t $FRONTEND_IMAGE:$IMAGE_TAG -t $FRONTEND_IMAGE:latest ./frontend'
            }
        }

        stage('Push to Docker Hub') {
            steps {
                echo 'Publicando imagen en Docker Hub...'
                sh 'echo $DOCKERHUB_CREDENTIALS_PSW | docker login -u $DOCKERHUB_CREDENTIALS_USR --password-stdin'
                sh 'docker push $FRONTEND_IMAGE:$IMAGE_TAG'
                sh 'docker push $FRONTEND_IMAGE:latest'
            }
            post {
                always {
                    sh 'docker logout'
                }
            }
        }

        stage('Deploy en Kubernetes') {
            when {
                expression { return params.DEPLOY == true }
            }
            steps {
                echo 'Desplegando frontend en Kubernetes...'
                sh 'kubectl apply -f k8s/00-namespace.yaml'
                sh 'kubectl apply -f k8s/05-frontend.yaml'
                sh "kubectl set image deployment/frontend frontend=$FRONTEND_IMAGE:$IMAGE_TAG -n devops-lab"
                sh 'kubectl rollout status deployment/frontend -n devops-lab --timeout=60s'
            }
        }

        stage('Validacion') {
            when {
                expression { return params.DEPLOY == true }
            }
            steps {
                echo 'Validando despliegue...'
                sh 'kubectl get pods -n devops-lab -l app=frontend'
                sh 'kubectl get svc frontend -n devops-lab'
            }
        }
    }

    post {
        success { echo "Frontend publicado exitosamente: $FRONTEND_IMAGE:$IMAGE_TAG" }
        failure { echo 'Pipeline del frontend fallido. Revisar logs.' }
    }
}
